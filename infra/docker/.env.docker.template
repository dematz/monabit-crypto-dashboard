# =============================================================================
# MonaBit — Docker Compose overrides (TEMPLATE)
# =============================================================================
# Copy this file to .env.docker and fill in your real values.
# NEVER commit .env.docker to git — it contains secrets.
#
# How to get your Supabase keys:
#   1. Go to https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
#   2. Copy "Project URL" → SUPABASE_URL
#   3. Copy "anon public" → SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#   4. Copy "service_role" → SUPABASE_SERVICE_ROLE_KEY
# =============================================================================

# Backend — remote Supabase
NODE_ENV=production
BACKEND_PORT=4000
DOCKER_BACKEND_PORT=4000
DOCKER_FRONTEND_PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Production: set ALLOWED_ORIGINS to your Cloud Run URLs only (no localhost)
# e.g. ALLOWED_ORIGINS=https://monabit-frontend-XXXXX.run.app,https://monabit-backend-XXXXX.run.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
MOCK_CRYPTO=false

# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Register at https://www.coingecko.com/en/api to get a Demo key (free, 30 req/min)
COINGECKO_API_KEY=

# Binance WebSocket
BINANCE_WS_URL=wss://stream.binance.com:9443

# Frontend — browser-visible URLs (not container-internal)
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_WS_URL=ws://localhost:4000/ws/prices

# Groq AI (optional — leave empty to keep simulated fallback)
GROQ_API_KEY=
