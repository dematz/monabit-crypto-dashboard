# =============================================================================
# MonaBit — Docker Compose & Cloud Run Deployment (TEMPLATE)
# =============================================================================
# Copy this file to .env.docker and fill in your real values.
# NEVER commit .env.docker to git — it contains secrets.
#
# How to get your Supabase keys:
#   1. Go to https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
#   2. Copy "Project URL" → SUPABASE_URL
#   3. Copy "anon public" → SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#   4. Copy "service_role" → SUPABASE_SERVICE_ROLE_KEY
# =============================================================================

# ─── GCP / Cloud Run ──────────────────────────────────────────────────────────
# GCP project ID where Cloud Run services live
GCP_PROJECT=your-gcp-project-id

# GCP region for Cloud Run services
GCP_REGION=us-central1

# Cloud Run service names
GCP_BACKEND_SERVICE=monabit-backend
GCP_FRONTEND_SERVICE=monabit-frontend

# Artifact Registry repo prefix (used to build image paths)
# Images will be: {GCP_REGISTRY}/backend and {GCP_REGISTRY}/frontend
GCP_REGISTRY=us-central1-docker.pkg.dev/your-gcp-project-id/monabit-registry

# Public URLs of deployed services (used for CORS, build args, and verification)
BACKEND_URL=https://your-backend-service-url.run.app
FRONTEND_URL=https://your-frontend-service-url.run.app

# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=4000

# Supabase — required for authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CORS — comma-separated origins allowed to call the API
# For production: set to your Cloud Run frontend URL + backend URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# CoinGecko — crypto market data provider
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Register at https://www.coingecko.com/en/api to get a Demo key (free, 30 req/min)
COINGECKO_API_KEY=

# Binance WebSocket — real-time price feed
BINANCE_WS_URL=wss://stream.binance.com:9443

# Groq — AI assistant provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30000

# Cache TTLs in seconds
CACHE_TTL_TOP10=60
CACHE_TTL_MARKET_OVERVIEW=120
CACHE_TTL_COIN_HISTORY=300

# Mock crypto data (true = no real API calls, false = CoinGecko)
MOCK_CRYPTO=false

LOG_LEVEL=info
APP_VERSION=0.1.0

# ─── Frontend ──────────────────────────────────────────────────────────────────
DOCKER_BACKEND_PORT=4000
DOCKER_FRONTEND_PORT=3000

# URLs the browser uses — for production set to your Cloud Run backend URL
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_WS_URL=ws://localhost:4000/ws/prices

# ─── Docker / Networking ─────────────────────────────────────────────────────
# Ports exposed on the host machine