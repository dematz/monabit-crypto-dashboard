# =============================================================================
# MonaBit — Docker Compose overrides
# =============================================================================
# This file is used by docker-compose.yml when running containers.
# It overrides host-local URLs with Docker-aware URLs.
# =============================================================================

# Backend — reach host services via host.docker.internal
NODE_ENV=production
BACKEND_PORT=4000
DOCKER_BACKEND_PORT=4000
DOCKER_FRONTEND_PORT=3000
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
MOCK_CRYPTO=true

# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Binance WebSocket
BINANCE_WS_URL=wss://stream.binance.com:9443

# Frontend — browser-visible URLs (not container-internal)
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://localhost:54321
VITE_WS_URL=ws://localhost:4000/ws/prices