# =============================================================================
# MonaBit Crypto Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For Docker, use .env.docker which overrides host-specific settings.
#
# Sections:
#   1. General
#   2. Backend
#   3. Frontend
#   4. Supabase (local)
#   5. External APIs
#   6. Docker / Networking
#   7. Ollama (AI assistant)
# =============================================================================

# ─── 1. General ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── 2. Backend ───────────────────────────────────────────────────────────────
BACKEND_PORT=4000
LOG_LEVEL=info
APP_VERSION=0.0.0

# CORS — comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Mock crypto data (true = no real API calls, false = CoinGecko)
MOCK_CRYPTO=true

# Cache TTLs in seconds
CACHE_TTL_TOP10=60
CACHE_TTL_MARKET_OVERVIEW=120
CACHE_TTL_COIN_HISTORY=300

# ─── 3. Frontend ─────────────────────────────────────────────────────────────
VITE_PORT=3100
# URL the browser uses to reach the backend API
VITE_API_URL=http://localhost:4000
# URL the browser uses to connect to the Binance WebSocket relay
VITE_WS_URL=ws://localhost:4000/ws/prices
# URL the browser uses to reach Supabase (Kong gateway)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# ─── 4. Supabase (local) ─────────────────────────────────────────────────────
# These are auto-generated by `supabase start`. Override for remote/prod.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Studio
SUPABASE_STUDIO_URL=http://127.0.0.1:54323

# Database direct connection
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── 5. External APIs ────────────────────────────────────────────────────────
# CoinGecko — free tier base URL (no key needed for /free endpoints)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# CoinGecko Pro API key (optional, for higher rate limits)
COINGECKO_API_KEY=

# Binance WebSocket feed for real-time prices
BINANCE_WS_URL=wss://stream.binance.com:9443

# ─── 6. Docker / Networking ──────────────────────────────────────────────────
# When running backend in Docker, Supabase runs on the host.
# Use "host.docker.internal" to reach the host from inside a container (Docker Desktop).
# On Linux, add `extra_hosts: ["host.docker.internal:host-gateway"]` to compose.
DOCKER_BACKEND_PORT=4000
DOCKER_FRONTEND_PORT=3000

# ─── 7. Ollama (AI assistant — planned) ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── 8. Google OAuth (Supabase Auth) ──────────────────────────────────────────
# Client ID and Secret from Google Cloud Console → OAuth 2.0 Web Client
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret