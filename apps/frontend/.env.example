# MonaBit Frontend — Environment Variables
# Copy this file to .env and fill in the values.

# Port for Vite dev server (default: 3000)
VITE_PORT=3100

# URL the browser uses to reach the backend API
VITE_API_URL=http://localhost:4000

# URL the browser uses to connect to the Binance WebSocket relay
VITE_WS_URL=ws://localhost:4000/ws/prices

# Supabase project URL (public, goes in browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (public, goes in browser bundle)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
