# MonaBit Backend — Variables de entorno
# Copiar a .env y ajustar según entorno local

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase — requerido para auth real (dejar vacío = mock/local mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Mock crypto (sin CoinGecko real)
MOCK_CRYPTO=true

# Cache TTLs (segundos)
CACHE_TTL_TOP10=60
CACHE_TTL_MARKET_OVERVIEW=120
CACHE_TTL_COIN_HISTORY=300

# Ollama (asistente IA local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
