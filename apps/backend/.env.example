# MonaBit Backend — Environment Variables
# Copy to .env and adjust for your local environment.
#
# Variables marked (required) must be set — the server will not start without them.
# All other variables have defaults and can be omitted for local development.

NODE_ENV=development
PORT=4000

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Project URL, anon key, and service role key from your Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_VERSION=0.0.0

# CORS — comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ─── Crypto data ──────────────────────────────────────────────────────────────
# Mock crypto data (true = no real API calls, CoinGecko and Binance are skipped)
MOCK_CRYPTO=true

# CoinGecko — crypto market data provider
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Binance WebSocket — real-time price feed
BINANCE_WS_URL=wss://stream.binance.com:9443

# ─── Cache TTLs (seconds) ─────────────────────────────────────────────────────
CACHE_TTL_TOP10=60
CACHE_TTL_MARKET_OVERVIEW=120
CACHE_TTL_COIN_HISTORY=300

# ─── Groq (AI assistant) ──────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30000
